<div class="rt-shell">
  <header class="rt-hero rarity-{{s.rarity}}"><img class="rt-portrait" src="{{item.img}}" data-action="editImage" data-edit="img"><div class="rt-identity"><p class="rt-eyebrow">{{localize (concat "RUNETERRA.Types." item.type)}}</p><input class="rt-name" name="name" value="{{item.name}}"><div class="rt-row"><select name="system.rarity">{{#each rarities}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button type="button" data-action="use">{{localize "RUNETERRA.Actions.use"}}</button></div></div></header>
  <main class="rt-body">
    <label>{{localize "RUNETERRA.Fields.description"}}</label><prose-mirror class="content-sized rt-description" name="system.description" value="{{s.description}}" data-document-uuid="{{item.uuid}}" toggled>{{{description}}}</prose-mirror>
    {{#if isWeapon}}<label>{{localize "RUNETERRA.Fields.weaponType"}}<input name="system.weaponType" value="{{s.weaponType}}"></label>{{/if}}
    <div class="rt-panel rt-grid">
      <label>{{localize "RUNETERRA.Fields.quantity"}}<input type="number" min="0" name="system.quantity" value="{{s.quantity}}"></label><label>{{localize "RUNETERRA.Fields.slots"}}<input type="number" min="0" name="system.slots" value="{{s.slots}}"></label><label>{{localize "RUNETERRA.Fields.price"}}<input type="number" min="0" name="system.price" value="{{s.price}}"></label>
      <label>{{localize "RUNETERRA.Fields.attribute"}}<select name="system.attribute">{{#each attributes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "RUNETERRA.Fields.level"}}<input type="number" min="1" max="4" name="system.level" value="{{s.level}}"></label><label>{{localize "RUNETERRA.Fields.xp"}}<input type="number" min="0" step="0.5" name="system.xp" value="{{s.xp}}"></label>
    </div>
    {{#if isEquipment}}<h3>{{localize "RUNETERRA.Fields.equipment"}}</h3><div class="rt-panel rt-grid">
      <label>{{localize "RUNETERRA.Fields.slot"}}<select name="system.slot">{{#each slots}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "RUNETERRA.Fields.equipmentHP"}}<input type="number" min="0" name="system.hp" value="{{s.hp}}"></label><label>{{localize "RUNETERRA.Fields.armor"}}<input type="number" min="0" name="system.armor" value="{{s.armor}}"></label><label>{{localize "RUNETERRA.Fields.magicResistance"}}<input type="number" min="0" name="system.magicResistance" value="{{s.magicResistance}}"></label><label>{{localize "RUNETERRA.Fields.clothingCold"}}<input type="number" min="0" max="4" name="system.cold" value="{{s.cold}}"></label>
      <label><input type="checkbox" name="system.equipped" {{checked s.equipped}}>{{localize "RUNETERRA.Fields.equipped"}}</label><label><input type="checkbox" name="system.broken" {{checked s.broken}}>{{localize "RUNETERRA.Fields.broken"}}</label>
      <label>{{localize "RUNETERRA.Fields.integrity"}}<input type="number" min="0" name="system.integrity.value" value="{{s.integrity.value}}"></label><label>{{localize "RUNETERRA.Fields.integrityMax"}}<input type="number" min="0" name="system.integrity.max" value="{{s.integrity.max}}"></label><label><input type="checkbox" name="system.integrity.indestructible" {{checked s.integrity.indestructible}}>{{localize "RUNETERRA.Fields.indestructible"}}</label>
    </div><button type="button" data-action="integrity">{{localize "RUNETERRA.Actions.integrity"}}</button>
    <details><summary>{{localize "RUNETERRA.Fields.bonuses"}}</summary><div class="rt-grid">{{#each bonuses}}<label>{{label}}<input type="number" name="system.bonuses.{{key}}" value="{{value}}"></label>{{/each}}</div></details>
    <div class="rt-grid"><label>{{localize "RUNETERRA.Fields.set"}}<input name="system.setId" value="{{s.setId}}"></label><label>{{localize "RUNETERRA.Fields.setSize"}}<input type="number" min="1" name="system.setSize" value="{{s.setSize}}"></label><label>{{localize "RUNETERRA.Fields.setDescription"}}<textarea name="system.setDescription">{{s.setDescription}}</textarea></label></div>{{/if}}
    {{#if isAbility}}<div class="rt-panel rt-grid"><label>{{localize "RUNETERRA.Fields.abilityKind"}}<select name="system.abilityKind">{{#each kinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>{{localize "RUNETERRA.Fields.alternateAttribute"}}<input name="system.alternateAttribute" value="{{s.alternateAttribute}}"></label><label>{{localize "RUNETERRA.Fields.alternateDescription"}}<textarea name="system.alternateDescription">{{s.alternateDescription}}</textarea></label></div>{{/if}}
    {{#if isWeapon}}<label>{{localize "RUNETERRA.Fields.mode"}}<select name="system.mode">{{#each modes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
    <div class="rt-panel rt-grid">
      <label>{{localize "RUNETERRA.Fields.damageFormula"}}<input name="system.damageFormula" value="{{s.damageFormula}}"></label><label>{{localize "RUNETERRA.Fields.damageType"}}<select name="system.damageType">{{#each types}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "RUNETERRA.Fields.penetration"}}<input type="number" min="0" name="system.penetration" value="{{s.penetration}}"></label><label><input type="checkbox" name="system.penetrating" {{checked s.penetrating}}>{{localize "RUNETERRA.Fields.penetrating"}}</label>
      <label>{{localize "RUNETERRA.Fields.healFormula"}}<input name="system.healFormula" value="{{s.healFormula}}"></label><label>{{localize "RUNETERRA.Fields.cooldown"}}<input type="number" min="0" name="system.cooldown" value="{{s.cooldown}}"></label><label>{{localize "RUNETERRA.Fields.remainingCooldown"}}<input type="number" min="0" name="system.remainingCooldown" value="{{s.remainingCooldown}}"></label><label>{{localize "RUNETERRA.Fields.duration"}}<input type="number" min="0" name="system.duration" value="{{s.duration}}"></label>
      <label><input type="checkbox" name="system.uses.limited" {{checked s.uses.limited}}>{{localize "RUNETERRA.Fields.limited"}}</label><label>{{localize "RUNETERRA.Fields.uses"}}<input type="number" min="0" name="system.uses.value" value="{{s.uses.value}}"></label><label>{{localize "RUNETERRA.Fields.usesMax"}}<input type="number" min="0" name="system.uses.max" value="{{s.uses.max}}"></label>
    </div>
    {{#if isProfession}}<div class="rt-panel rt-grid"><label>{{localize "RUNETERRA.Fields.value"}}<input type="number" min="0" max="100" name="system.value" value="{{s.value}}"></label><label>{{localize "RUNETERRA.Fields.practice"}}<input type="number" min="0" step="0.5" name="system.practice" value="{{s.practice}}"></label><label>{{localize "RUNETERRA.Fields.streak"}}<input type="number" min="0" name="system.streak" value="{{s.streak}}"></label><label><input type="checkbox" name="system.guild" {{checked s.guild}}>{{localize "RUNETERRA.Fields.guild"}}</label><label>{{localize "RUNETERRA.Fields.guildMissions"}}<input type="number" min="0" name="system.guildMissions" value="{{s.guildMissions}}"></label><label><input type="checkbox" name="system.guildFinal" {{checked s.guildFinal}}>{{localize "RUNETERRA.Fields.guildFinal"}}</label></div>{{/if}}
    {{#if isConsumable}}<div class="rt-panel rt-grid"><label><input type="checkbox" name="system.food" {{checked s.food}}>{{localize "RUNETERRA.Fields.food"}}</label><label>{{localize "RUNETERRA.Fields.foodKind"}}<select name="system.foodKind">{{selectOptions (rtFoodKinds) selected=s.foodKind}}</select></label><label><input type="checkbox" name="system.preserved" {{checked s.preserved}}>{{localize "RUNETERRA.Fields.preserved"}}</label><label>{{localize "RUNETERRA.Fields.hydration"}}<input type="number" min="0" step="0.1" name="system.hydration" value="{{s.hydration}}"></label></div>{{/if}}
    <label>{{localize "RUNETERRA.Fields.recipe"}}<textarea name="system.recipe">{{s.recipe}}</textarea></label><label>{{localize "RUNETERRA.Fields.dangers"}}<textarea name="system.dangers">{{s.dangers}}</textarea></label>
    {{#if isRune}}<button type="button" data-action="recharge" data-owner>{{localize "RUNETERRA.Actions.recharge"}}</button>{{/if}}
    {{#if isConsumable}}<label>{{localize "RUNETERRA.Fields.automation"}}<input name="system.automation" value="{{s.automation}}"></label>{{/if}}
    <div class="rt-row"><button type="button" data-action="purchase">{{localize "RUNETERRA.Actions.purchase"}}</button><button type="button" data-action="craft">{{localize "RUNETERRA.Actions.craft"}}</button></div>
    <div class="rt-grid"><label>{{localize "RUNETERRA.Fields.targetMode"}}<select name="system.targetMode">{{selectOptions (rtTargetModes) selected=s.targetMode}}</select></label><label>{{localize "RUNETERRA.Fields.dotKind"}}<select name="system.dot.kind">{{selectOptions (rtDotKinds) selected=s.dot.kind}}</select></label><label>{{localize "RUNETERRA.Fields.dotLevel"}}<input type="number" min="0" max="4" name="system.dot.level" value="{{s.dot.level}}"></label></div>
    <button type="button" data-action="modifiers" data-owner>{{localize "RUNETERRA.Actions.modifiers"}}</button>
    <label>{{localize "RUNETERRA.Fields.source"}}<input name="system.source" value="{{s.source}}"></label>
    {{#if isGM}}<label>{{localize "RUNETERRA.Fields.gmNotes"}}<textarea name="system.gmNotes" rows="4">{{s.gmNotes}}</textarea></label>{{/if}}
  </main>
</div>
